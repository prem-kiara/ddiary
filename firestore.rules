rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Platform-wide super admins ───────────────────────────────────────
    // These two accounts can read and write EVERY document in the database.
    // Add or remove emails here to manage super admin membership.
    // NOTE: this function is used as an explicit bypass on every rule block
    // below, AND as a catch-all at the bottom, so super admins are never
    // blocked by any workspace-membership or ownership check.
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'suren@dhanam.finance' ||
        request.auth.token.email == 'gokul@dhanam.finance' ||
        request.auth.token.email == 'prem.karnan@dhanam.finance'
      );
    }

    // ─── User profiles & all subcollections ───────────────────────────────
    match /users/{userId} {
      allow read, write: if isSuperAdmin()
                          || (request.auth != null && request.auth.uid == userId);

      // Diary entries — owner only (super admin can read/write any)
      match /entries/{entryId} {
        allow read, write: if isSuperAdmin()
                            || (request.auth != null && request.auth.uid == userId);
      }

      // Tasks — owner full control; assignee can read/update; super admin can do anything
      match /tasks/{taskId} {
        allow read:   if isSuperAdmin()
                       || (request.auth != null
                           && (request.auth.uid == userId
                               || request.auth.uid == resource.data.assigneeUid
                               || request.auth.token.email == resource.data.assigneeEmail));
        allow create: if isSuperAdmin()
                       || (request.auth != null && request.auth.uid == userId);
        allow update: if isSuperAdmin()
                       || (request.auth != null
                           && (request.auth.uid == userId
                               || request.auth.uid == resource.data.assigneeUid
                               || resource.data.assigneeEmail != null));
        allow delete: if isSuperAdmin()
                       || (request.auth != null && request.auth.uid == userId);

        // Comments — any authenticated user can read/create; only author or super admin can edit/delete
        match /comments/{commentId} {
          allow read, create:   if request.auth != null;
          allow update, delete: if isSuperAdmin()
                                 || (request.auth != null
                                     && request.auth.uid == resource.data.authorUid);
        }

        // Activity log — any authenticated user can read/create; immutable once written
        match /activity/{activityId} {
          allow read, create:   if request.auth != null;
          allow update, delete: if false;
        }
      }

      // Team members — owner only (super admin can read/write any)
      match /teamMembers/{memberId} {
        allow read, write: if isSuperAdmin()
                            || (request.auth != null && request.auth.uid == userId);
      }

      // Error logs — create-only
      match /errorLogs/{logId} {
        allow create:             if request.auth != null && request.auth.uid == userId;
        allow read, update, delete: if false;
      }
    }

    // ─── Collection-group: lets assignees + creators query their tasks ───────
    // Used by:
    //   - useAssignedTasks (where assigneeEmail == me)
    //   - usePlatformTasks "mine" mode  (where assigneeEmail == me OR createdBy == me)
    //   - useReminderDispatcher  (where createdBy == me)
    // NOTE: update is intentionally omitted here — specific rules above handle it.
    match /{path=**}/tasks/{taskId} {
      allow read: if isSuperAdmin()
                   || (request.auth != null
                       && (resource.data.assigneeUid   == request.auth.uid
                           || resource.data.assigneeEmail == request.auth.token.email
                           || resource.data.createdBy    == request.auth.uid));
    }

    // ─── User directory — lets the owner discover who has signed up ───────
    match /userDirectory/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete:         if request.auth != null && request.auth.uid == uid;
      allow read:           if request.auth != null;
    }

    // ─── In-app notifications (real-time, live) ──────────────────────────
    match /notifications/{notifId} {
      allow create: if request.auth != null
                   && (request.resource.data.senderEmail == request.auth.token.email
                       || request.resource.data.senderEmail == null
                       || !('senderEmail' in request.resource.data));
      allow read:   if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.recipientEmail == request.auth.token.email);
      allow update: if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.recipientEmail == request.auth.token.email);
      allow delete: if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.recipientEmail == request.auth.token.email);
    }

    // ─── Anonymous error logs (pre-auth) ─────────────────────────────────
    match /errorLogs/{logId} {
      allow create:             if request.auth != null;
      allow read, update, delete: if false;
    }

    // ─── Workspaces — shared Kanban boards ───────────────────────────────
    //
    // Access model:
    //   - Super admins bypass ALL membership checks — they see and can
    //     administer every workspace and every task.
    //   - Regular users: only members (or the creator) can read workspaces
    //     and tasks.
    //   - Any member can create/read/update tasks and comments.
    //   - Status updates are enforced by the UI (assignee only), not rules —
    //     keeping rules simple and reliable with UID-based member lookup.
    //   - Admin = workspace creator OR a member with role:'admin'.
    match /workspaces/{workspaceId} {
      function isWorkspaceMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      }
      function isWorkspaceCreator() {
        return request.auth != null &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;
      }
      // Creator bypass guards against the common race where the workspace doc
      // exists but the member doc hasn't been written / replicated yet, and
      // against legacy workspaces that never got a member entry.
      function canAccessWorkspace() {
        return isWorkspaceMember() || isWorkspaceCreator();
      }

      // ── Workspace doc ────────────────────────────────────────────────────
      allow read:           if isSuperAdmin()
                             || canAccessWorkspace()
                             || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow create:         if request.auth != null;
      allow update, delete: if isSuperAdmin() || canAccessWorkspace();

      // ── Members sub-collection ───────────────────────────────────────────
      // Read is open to authenticated users so useMyWorkspaces collection-group
      // query can fetch workspace docs after finding member entries.
      match /members/{uid} {
        allow read:           if request.auth != null;
        allow create, update: if request.auth != null;          // joining / invite acceptance
        allow delete:         if isSuperAdmin()
                               || canAccessWorkspace()          // admin/creator removes others
                               || request.auth.uid == uid;     // member removes themselves (leave)
      }

      // ── Tasks sub-collection ─────────────────────────────────────────────
      // Super admins can read, create, update, and delete ANY task in any
      // workspace. Regular members can read/create/update; delete is restricted
      // to the task creator or the workspace creator.
      match /tasks/{taskId} {
        allow read, create: if isSuperAdmin() || canAccessWorkspace();
        allow update:       if isSuperAdmin() || canAccessWorkspace();
        allow delete:       if isSuperAdmin()
                             || (canAccessWorkspace()
                                 && (resource.data.createdBy == request.auth.uid
                                     || isWorkspaceCreator()));

        // Comments — workspace members/creator can read/create;
        // only author or super admin can edit/delete
        match /comments/{commentId} {
          allow read, create:   if isSuperAdmin() || canAccessWorkspace();
          allow update, delete: if isSuperAdmin()
                                 || (request.auth != null
                                     && request.auth.uid == resource.data.authorUid);
        }

        // Activity log — members/creator can read/create; immutable once written
        match /activity/{activityId} {
          allow read, create:   if isSuperAdmin() || canAccessWorkspace();
          allow update, delete: if false;
        }
      }
    }

    // ─── Collection-group: lets users discover which workspaces they belong to
    match /{path=**}/members/{uid} {
      allow read: if request.auth != null;
    }

    // ─── Workspace leave requests ─────────────────────────────────────────────
    match /workspaceLeaveRequests/{reqId} {
      allow create: if request.auth != null
                   && request.resource.data.memberUid == request.auth.uid;
      allow read:   if isSuperAdmin()
                     || (request.auth != null
                         && (resource.data.memberUid    == request.auth.uid
                             || resource.data.ownerEmail == request.auth.token.email));
      allow update: if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.ownerEmail == request.auth.token.email);
      allow delete: if isSuperAdmin()
                     || (request.auth != null
                         && (resource.data.memberUid    == request.auth.uid
                             || resource.data.ownerEmail == request.auth.token.email));
    }

    // ─── Workspace invites ────────────────────────────────────────────────────
    // read is open to all authenticated users because:
    //   a) invite doc ID is deterministic ({workspaceId}_{inviteeEmail}) — obscure enough
    //   b) getExistingInvite() reads docs that may NOT exist yet; accessing resource.data
    //      on a null resource causes a rules error → permission denied → invite breaks
    match /workspaceInvites/{inviteId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update: if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.inviteeEmail == request.auth.token.email);
      allow delete: if isSuperAdmin()
                     || (request.auth != null
                         && resource.data.inviterUid == request.auth.uid);
    }

    // ─── Final safety net: super admins bypass everything else ────────────
    // This catch-all ensures no edge-case path can accidentally lock out a
    // super admin even if a specific rule above is missing a bypass.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
