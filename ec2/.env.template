# ddiary-server/.env
# ─────────────────────────────────────────────────────
# SECURITY: chmod 600 this file. Never commit to git.
# Copy this to .env and fill in real values on EC2.
# ─────────────────────────────────────────────────────

# Express port — must not conflict with other apps on this EC2 box.
# 3002 is taken by codpulse (Kiara Microcredit), 3010 = dhanam-fi.
# 2026-07-22: moved from 3002 → 3003 after codpulse took over 3002 and
# silently broke DDiary email for a month. Keep in sync with the
# proxy_pass port in nginx-diary.dhanamfinance.com.conf.
PORT=3003

# AWS SES region — must match where you verified dhanam.finance
AWS_REGION=ap-south-1

# Sender address — must be from a domain verified in SES
SENDER_EMAIL=tech@dhanam.finance

# App URL — used in email deep links (task reminder "View Task" button)
# During transition: keep as dhanamdiary.web.app until DNS is confirmed working on diary.dhanamfinance.com
APP_URL=https://diary.dhanamfinance.com

# Recipient domain allowlist for /api/notify (comma-separated).
# Defaults to dhanam.finance if unset; non-matching recipients get 403.
# ALLOWED_EMAIL_DOMAINS=dhanam.finance

# ── AWS Credentials ───────────────────────────────────
# Leave blank if EC2 has an IAM role with ses:SendEmail attached (preferred).
# Only set these if NOT using an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
